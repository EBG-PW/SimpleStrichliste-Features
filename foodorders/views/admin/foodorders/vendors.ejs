<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-translate="FoodOrders.Admin.Vendors"></title>
    <%- html_content.manifest %>
    <script>
      const lang = <%- JSON.stringify(language) %>;
      const features = <%- JSON.stringify(features) %>;
    </script>
    <script src="<%= domain %>/libjs/i18next.js?<%= curentUnixTime %>"></script>
    <script src="<%= domain %>/libjs/tailwind.js?<%= curentUnixTime %>"></script>
  </head>

  <body class="bg-gray-100 font-sans">
    <%- html_content.navbar %>

    <main class="container mx-auto p-4 md:p-6">
      <header class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div class="flex items-start gap-4">
          <a href="/admin/foodorders" class="mt-1 text-gray-500 hover:text-gray-800" data-translate-title="FoodOrders.Admin.BackToOrders">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
          </a>
          <div>
            <h1 class="text-2xl font-bold text-gray-900" data-translate="FoodOrders.Admin.Vendors"></h1>
            <p class="text-sm text-gray-600" data-translate="FoodOrders.Admin.VendorsSubtitle"></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="openVendorModal()" class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700" data-translate="FoodOrders.Admin.AddVendor"></button>
        </div>
      </header>

      <section class="rounded-lg bg-white shadow">
        <div class="flex flex-col gap-3 border-b border-gray-200 p-4 md:flex-row md:items-end md:justify-between">
          <input id="search-input" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm md:max-w-sm" data-translate-placeholder="FoodOrders.Admin.SearchVendors" />
          <button type="button" onclick="loadVendors(1)" class="rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" data-translate="FoodOrders.Refresh"></button>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="border-b bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.Name"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.Description"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.HasMenu"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.IsActive"></th>
                <th class="px-4 py-3 text-right" data-translate="FoodOrders.Admin.Actions"></th>
              </tr>
            </thead>
            <tbody id="vendors-body"></tbody>
          </table>
        </div>
        <div id="pagination" class="flex items-center justify-between border-t border-gray-200 p-4 text-sm"></div>
      </section>
    </main>

    <div id="vendor-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60 p-4">
      <form id="vendor-form" class="w-full max-w-lg rounded-lg bg-white p-5 shadow-2xl">
        <h2 class="mb-4 text-lg font-bold text-gray-900" data-translate="FoodOrders.Admin.VendorModalTitle"></h2>
        <input id="vendor-uuid" type="hidden" />
        <div class="space-y-4">
          <div>
            <label for="vendor-name" class="block text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.Name"></label>
            <input id="vendor-name" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
          </div>
          <div>
            <label for="vendor-description" class="block text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.Description"></label>
            <textarea id="vendor-description" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2"></textarea>
          </div>
          <label class="flex items-center justify-between rounded-lg border border-gray-200 p-3">
            <span class="text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.HasMenu"></span>
            <input id="vendor-has-menu" type="checkbox" class="h-5 w-5" checked />
          </label>
          <label class="flex items-center justify-between rounded-lg border border-gray-200 p-3">
            <span class="text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.IsActive"></span>
            <input id="vendor-is-active" type="checkbox" class="h-5 w-5" checked />
          </label>
        </div>
        <div class="mt-5 flex justify-end gap-3">
          <button type="button" onclick="closeVendorModal()" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700" data-translate="FoodOrders.Admin.Cancel"></button>
          <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white" data-translate="FoodOrders.Admin.Save"></button>
        </div>
      </form>
    </div>

    <script src="<%= domain %>/appjs/permission.js?<%= curentUnixTime %>" defer></script>
    <script src="<%= domain %>/appjs/translate.js?<%= curentUnixTime %>"></script>
    <script>
      let vendors = [];
      let currentPage = 1;

      async function requestJson(url, options = {}) {
        const response = await apiFetch(url, options);
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          const message = typeof data.error === "string" && data.error.startsWith("FoodOrders.") ? t(data.error) : t("FoodOrders.RequestFailed");
          throw new Error(message);
        }
        return data;
      }

      async function loadVendors(page = currentPage) {
        currentPage = page;
        const query = new URLSearchParams({
          page,
          limit: 15,
          query: document.getElementById("search-input").value,
        });
        const data = await requestJson(`/api/v1/foodorders/admin/vendors?${query}`);
        vendors = data.vendors;
        renderVendors();
        renderPagination(data.pagination);
      }

      function renderVendors() {
        document.getElementById("vendors-body").innerHTML = vendors.map((vendor) => `
          <tr class="border-b">
            <td class="px-4 py-3 font-semibold text-gray-900">${vendor.name}</td>
            <td class="max-w-md whitespace-pre-wrap break-words px-4 py-3 text-gray-600">${vendor.description || ""}</td>
            <td class="px-4 py-3">${vendor.hasMenu ? t("FoodOrders.Admin.Yes") : t("FoodOrders.Admin.No")}</td>
            <td class="px-4 py-3">${vendor.isActive ? t("FoodOrders.Admin.Active") : t("FoodOrders.Admin.Inactive")}</td>
            <td class="px-4 py-3">
              <div class="flex justify-end gap-2">
                <a href="/admin/foodorders/vendors/${vendor.uuid}/items" class="rounded border border-gray-300 px-3 py-1 text-xs font-semibold text-gray-700 hover:bg-gray-50">${t("FoodOrders.Admin.ManageItems")}</a>
                <button type="button" onclick="openVendorModal('${vendor.uuid}')" class="rounded border border-gray-300 px-3 py-1 text-xs font-semibold text-gray-700 hover:bg-gray-50">${t("FoodOrders.Admin.Edit")}</button>
              </div>
            </td>
          </tr>
        `).join("") || `<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">${t("FoodOrders.Admin.NoVendors")}</td></tr>`;
      }

      function renderPagination(pagination) {
        document.getElementById("pagination").innerHTML = `
          <span>${pagination.total} ${t("FoodOrders.Admin.Rows")}</span>
          <div class="flex gap-2">
            <button ${pagination.page <= 1 ? "disabled" : ""} onclick="loadVendors(${pagination.page - 1})" class="rounded border border-gray-300 px-3 py-1 disabled:opacity-50">${t("FoodOrders.Admin.Previous")}</button>
            <span class="px-2 py-1">${pagination.page} / ${pagination.totalPages}</span>
            <button ${pagination.page >= pagination.totalPages ? "disabled" : ""} onclick="loadVendors(${pagination.page + 1})" class="rounded border border-gray-300 px-3 py-1 disabled:opacity-50">${t("FoodOrders.Admin.Next")}</button>
          </div>
        `;
      }

      function openVendorModal(uuid = null) {
        const vendor = vendors.find((entry) => entry.uuid === uuid);
        document.getElementById("vendor-uuid").value = vendor?.uuid || "";
        document.getElementById("vendor-name").value = vendor?.name || "";
        document.getElementById("vendor-description").value = vendor?.description || "";
        document.getElementById("vendor-has-menu").checked = vendor?.hasMenu ?? true;
        document.getElementById("vendor-is-active").checked = vendor?.isActive ?? true;
        document.getElementById("vendor-modal").classList.remove("hidden");
        document.getElementById("vendor-modal").classList.add("flex");
      }

      function closeVendorModal() {
        document.getElementById("vendor-modal").classList.add("hidden");
        document.getElementById("vendor-modal").classList.remove("flex");
      }

      async function saveVendor(event) {
        event.preventDefault();
        const uuid = document.getElementById("vendor-uuid").value;
        await requestJson(uuid ? `/api/v1/foodorders/admin/vendors/${uuid}` : "/api/v1/foodorders/admin/vendors", {
          method: uuid ? "PUT" : "POST",
          body: JSON.stringify({
            name: document.getElementById("vendor-name").value,
            description: document.getElementById("vendor-description").value,
            hasMenu: document.getElementById("vendor-has-menu").checked,
            isActive: document.getElementById("vendor-is-active").checked,
          }),
        });
        closeVendorModal();
        showMessage(t("FoodOrders.Admin.VendorSaved"));
        await loadVendors();
      }

      document.addEventListener("DOMContentLoaded", () => {
        document.title = t("FoodOrders.Admin.Vendors");
        document.getElementById("search-input").addEventListener("input", () => loadVendors(1).catch((error) => showMessage(error.message, "error")));
        document.getElementById("vendor-form").addEventListener("submit", (event) => saveVendor(event).catch((error) => showMessage(error.message, "error")));
        loadVendors(1).catch((error) => showMessage(error.message, "error"));
      });
    </script>
  </body>
</html>
