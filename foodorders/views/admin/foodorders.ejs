<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-translate="FoodOrders.Admin.Orders"></title>
    <%- html_content.manifest %>
    <script>
      const lang = <%- JSON.stringify(language) %>;
      const features = <%- JSON.stringify(features) %>;
    </script>
    <script src="<%= domain %>/libjs/i18next.js?<%= curentUnixTime %>"></script>
    <script src="<%= domain %>/libjs/tailwind.js?<%= curentUnixTime %>"></script>
  </head>

  <body class="bg-gray-100 font-sans">
    <%- html_content.navbar %>

    <main class="container mx-auto p-4 md:p-6">
      <header class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900" data-translate="FoodOrders.Admin.Orders"></h1>
          <p class="text-sm text-gray-600" data-translate="FoodOrders.Admin.OrdersSubtitle"></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin/foodorders/vendors" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" data-translate="FoodOrders.Admin.ManageVendors"></a>
          <a href="/admin/foodorders/vendors" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" data-translate="FoodOrders.Admin.EditItems"></a>
          <button type="button" onclick="openOrderModal()" class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700" data-translate="FoodOrders.Admin.NewOrder"></button>
        </div>
      </header>

      <div id="message-box-container" class="fixed bottom-5 right-5 z-50 w-full max-w-xs">
        <div id="message-box" class="hidden mt-4 rounded-lg p-4 shadow-lg"></div>
      </div>

      <section class="rounded-lg bg-white shadow">
        <div class="flex flex-col gap-3 border-b border-gray-200 p-4 md:flex-row md:items-end md:justify-between">
          <div class="grid grid-cols-1 gap-3 md:grid-cols-[260px_180px]">
            <input id="search-input" class="rounded-lg border border-gray-300 px-3 py-2 text-sm" data-translate-placeholder="FoodOrders.Admin.SearchOrders" />
            <select id="status-filter" class="rounded-lg border border-gray-300 px-3 py-2 text-sm"></select>
          </div>
          <button type="button" onclick="loadOrders(1)" class="rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" data-translate="FoodOrders.Refresh"></button>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="border-b bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.Title"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.Vendor"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Status"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.OrderItemCount"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Price"></th>
                <th class="px-4 py-3" data-translate="FoodOrders.Admin.Deadline"></th>
              </tr>
            </thead>
            <tbody id="orders-body"></tbody>
          </table>
        </div>
        <div id="pagination" class="flex items-center justify-between border-t border-gray-200 p-4 text-sm"></div>
      </section>
    </main>

    <div id="order-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60 p-4">
      <form id="order-form" class="w-full max-w-lg rounded-lg bg-white p-5 shadow-2xl">
        <h2 class="mb-4 text-lg font-bold text-gray-900" data-translate="FoodOrders.Admin.OrderModalTitle"></h2>
        <div class="space-y-4">
          <div>
            <label for="order-title" class="block text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.Title"></label>
            <input id="order-title" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
          </div>
          <div>
            <label for="order-vendor" class="block text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.Vendor"></label>
            <select id="order-vendor" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2"></select>
          </div>
          <div>
            <label for="order-deadline" class="block text-sm font-medium text-gray-700" data-translate="FoodOrders.Admin.Deadline"></label>
            <input id="order-deadline" type="datetime-local" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
          </div>
        </div>
        <div class="mt-5 flex justify-end gap-3">
          <button type="button" onclick="closeOrderModal()" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700" data-translate="FoodOrders.Admin.Cancel"></button>
          <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white" data-translate="FoodOrders.Admin.Start"></button>
        </div>
      </form>
    </div>

    <div id="detail-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60 p-4">
      <div class="flex max-h-[90vh] w-full max-w-5xl flex-col rounded-lg bg-white shadow-2xl">
        <div class="flex items-start justify-between border-b border-gray-200 p-5">
          <div>
            <h2 id="detail-title" class="text-xl font-bold text-gray-900"></h2>
            <p id="detail-subtitle" class="text-sm text-gray-600"></p>
          </div>
          <button type="button" onclick="closeDetailModal()" class="rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700" data-translate="FoodOrders.Admin.Close"></button>
        </div>
        <div class="overflow-auto p-5">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <label class="text-sm font-medium text-gray-700" data-translate="FoodOrders.Status"></label>
            <select id="detail-order-status" class="rounded-lg border border-gray-300 px-3 py-2 text-sm"></select>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="border-b bg-gray-50 text-xs uppercase text-gray-500">
                <tr>
                  <th class="px-3 py-2" data-translate="FoodOrders.Admin.Person"></th>
                  <th class="px-3 py-2" data-translate="FoodOrders.Item"></th>
                  <th class="px-3 py-2" data-translate="FoodOrders.Quantity"></th>
                  <th class="px-3 py-2" data-translate="FoodOrders.Price"></th>
                  <th class="px-3 py-2" data-translate="FoodOrders.Note"></th>
                  <th class="px-3 py-2" data-translate="FoodOrders.Status"></th>
                </tr>
              </thead>
              <tbody id="detail-items"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <script src="<%= domain %>/appjs/permission.js?<%= curentUnixTime %>" defer></script>
    <script src="<%= domain %>/appjs/translate.js?<%= curentUnixTime %>"></script>
    <script>
      const money = new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR" });
      const orderStatuses = ["", "open", "closed", "ordered", "completed", "cancelled"];
      const itemStatuses = ["requested", "ordered", "completed", "missing", "cancelled"];
      let currentPage = 1;
      let currentOrder = null;
      const messageBox = document.getElementById("message-box");

      function showMessage(text, type = "success") {
        messageBox.textContent = text;
        messageBox.className = `mt-4 rounded-lg p-4 shadow-lg ${type === "success" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"}`;
        messageBox.classList.remove("hidden");
        setTimeout(() => messageBox.classList.add("hidden"), 4000);
      }

      async function requestJson(url, options = {}) {
        const response = await apiFetch(url, options);
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          const message = typeof data.error === "string" && data.error.startsWith("FoodOrders.") ? t(data.error) : t("FoodOrders.RequestFailed");
          throw new Error(message);
        }
        return data;
      }

      function renderStatusOptions(selected, includeAll = false) {
        const statuses = includeAll ? orderStatuses : orderStatuses.filter(Boolean);
        return statuses.map((status) => `<option value="${status}" ${selected === status ? "selected" : ""}>${status ? t(`FoodOrders.Statuses.${status}`) : t("FoodOrders.Admin.AllStatuses")}</option>`).join("");
      }

      async function loadVendorsForOrder() {
        const data = await requestJson("/api/v1/foodorders/admin/vendors?limit=50");
        document.getElementById("order-vendor").innerHTML = data.vendors
          .filter((vendor) => vendor.isActive)
          .map((vendor) => `<option value="${vendor.uuid}">${vendor.name}</option>`)
          .join("");
      }

      async function loadOrders(page = currentPage) {
        currentPage = page;
        const query = new URLSearchParams({
          page,
          limit: 15,
          query: document.getElementById("search-input").value,
          status: document.getElementById("status-filter").value,
        });
        const data = await requestJson(`/api/v1/foodorders/admin/orders?${query}`);
        renderOrders(data.orders);
        renderPagination(data.pagination);
      }

      function renderOrders(orders) {
        document.getElementById("orders-body").innerHTML = orders.map((order) => `
          <tr onclick="openDetailModal('${order.uuid}')" class="cursor-pointer border-b hover:bg-gray-50">
            <td class="px-4 py-3 font-semibold text-gray-900">${order.title}</td>
            <td class="px-4 py-3">${order.vendor?.name || t("FoodOrders.NoVendor")}</td>
            <td class="px-4 py-3">${t(`FoodOrders.Statuses.${order.status}`)}</td>
            <td class="px-4 py-3">${order.itemCount}</td>
            <td class="px-4 py-3">${money.format(order.total)}</td>
            <td class="px-4 py-3">${order.orderDeadline ? new Date(order.orderDeadline).toLocaleString("de-DE") : t("FoodOrders.NoDeadline")}</td>
          </tr>
        `).join("") || `<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">${t("FoodOrders.Admin.NoOrders")}</td></tr>`;
      }

      function renderPagination(pagination) {
        document.getElementById("pagination").innerHTML = `
          <span>${pagination.total} ${t("FoodOrders.Admin.Rows")}</span>
          <div class="flex gap-2">
            <button ${pagination.page <= 1 ? "disabled" : ""} onclick="loadOrders(${pagination.page - 1})" class="rounded border border-gray-300 px-3 py-1 disabled:opacity-50">${t("FoodOrders.Admin.Previous")}</button>
            <span class="px-2 py-1">${pagination.page} / ${pagination.totalPages}</span>
            <button ${pagination.page >= pagination.totalPages ? "disabled" : ""} onclick="loadOrders(${pagination.page + 1})" class="rounded border border-gray-300 px-3 py-1 disabled:opacity-50">${t("FoodOrders.Admin.Next")}</button>
          </div>
        `;
      }

      function openOrderModal() {
        document.getElementById("order-form").reset();
        document.getElementById("order-modal").classList.remove("hidden");
        document.getElementById("order-modal").classList.add("flex");
      }

      function closeOrderModal() {
        document.getElementById("order-modal").classList.add("hidden");
        document.getElementById("order-modal").classList.remove("flex");
      }

      async function openDetailModal(uuid) {
        const data = await requestJson(`/api/v1/foodorders/admin/orders/${uuid}`);
        currentOrder = data.order;
        document.getElementById("detail-title").textContent = currentOrder.title;
        document.getElementById("detail-subtitle").textContent = `${currentOrder.vendor?.name || t("FoodOrders.NoVendor")} - ${money.format(currentOrder.total)}`;
        const orderStatus = document.getElementById("detail-order-status");
        orderStatus.innerHTML = renderStatusOptions(currentOrder.status);
        orderStatus.onchange = () => updateOrderStatus(currentOrder.uuid, orderStatus.value);
        document.getElementById("detail-items").innerHTML = currentOrder.items.map((item) => `
          <tr class="border-b">
            <td class="px-3 py-2">${item.user.name}</td>
            <td class="max-w-sm whitespace-pre-wrap break-words px-3 py-2">${item.itemName}</td>
            <td class="px-3 py-2">${item.quantity}</td>
            <td class="px-3 py-2">${money.format(item.total)}</td>
            <td class="max-w-sm whitespace-pre-wrap break-words px-3 py-2">${item.note || ""}</td>
            <td class="px-3 py-2">
              <select onchange="updateOrderItemStatus(${item.id}, this.value)" class="rounded-lg border border-gray-300 px-2 py-1 text-xs">
                ${itemStatuses.map((status) => `<option value="${status}" ${item.status === status ? "selected" : ""}>${t(`FoodOrders.Statuses.${status}`)}</option>`).join("")}
              </select>
              ${item.chargedAt ? `<div class="mt-1 text-xs text-green-600">${t("FoodOrders.Charged")}</div>` : ""}
            </td>
          </tr>
        `).join("") || `<tr><td colspan="6" class="px-3 py-6 text-center text-gray-500">${t("FoodOrders.Admin.NoOrderItems")}</td></tr>`;
        document.getElementById("detail-modal").classList.remove("hidden");
        document.getElementById("detail-modal").classList.add("flex");
      }

      function closeDetailModal() {
        document.getElementById("detail-modal").classList.add("hidden");
        document.getElementById("detail-modal").classList.remove("flex");
      }

      async function saveOrder(event) {
        event.preventDefault();
        await requestJson("/api/v1/foodorders/admin/orders", {
          method: "POST",
          body: JSON.stringify({
            title: document.getElementById("order-title").value,
            vendorUuid: document.getElementById("order-vendor").value,
            orderDeadline: document.getElementById("order-deadline").value,
            status: "open",
          }),
        });
        closeOrderModal();
        showMessage(t("FoodOrders.Admin.OrderStarted"));
        await loadOrders(1);
      }

      async function updateOrderStatus(uuid, status) {
        await requestJson(`/api/v1/foodorders/admin/orders/${uuid}/status`, { method: "PUT", body: JSON.stringify({ status }) });
        showMessage(t("FoodOrders.Admin.OrderStatusUpdated"));
        if (currentOrder?.uuid === uuid) await openDetailModal(uuid);
        await loadOrders();
      }

      async function updateOrderItemStatus(id, status) {
        const data = await requestJson(`/api/v1/foodorders/admin/order-items/${id}/status`, { method: "PUT", body: JSON.stringify({ status }) });
        showMessage(data.charged ? t("FoodOrders.Admin.OrderItemCharged") : t("FoodOrders.Admin.OrderItemStatusUpdated"));
        if (currentOrder) await openDetailModal(currentOrder.uuid);
        await loadOrders();
      }

      document.addEventListener("DOMContentLoaded", async () => {
        document.title = t("FoodOrders.Admin.Orders");
        document.getElementById("status-filter").innerHTML = renderStatusOptions("", true);
        document.getElementById("search-input").addEventListener("input", () => loadOrders(1).catch((error) => showMessage(error.message, "error")));
        document.getElementById("status-filter").addEventListener("change", () => loadOrders(1).catch((error) => showMessage(error.message, "error")));
        document.getElementById("order-form").addEventListener("submit", (event) => saveOrder(event).catch((error) => showMessage(error.message, "error")));
        await loadVendorsForOrder();
        await loadOrders(1);
      });
    </script>
  </body>
</html>
