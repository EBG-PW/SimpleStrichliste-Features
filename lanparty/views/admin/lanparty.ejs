<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-translate="Lanparty.Admin.Title"></title>
    <%- html_content.manifest %>
    <script>
      const lang = <%- JSON.stringify(language) %>;
      const features = <%- JSON.stringify(features) %>;
    </script>
    <script src="<%= domain %>/libjs/i18next.js?<%= curentUnixTime %>"></script>
    <script src="<%= domain %>/libjs/tailwind.js?<%= curentUnixTime %>"></script>
  </head>
  <body class="bg-gray-100 font-sans">
    <%- html_content.navbar %>
    <main class="container mx-auto p-4 md:p-6">
      <header class="mb-6 flex items-center gap-4">
        <a href="/admin/index" class="text-gray-500 hover:text-gray-800" aria-label="Go back">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-800" data-translate="Lanparty.Admin.Title"></h1>
          <p class="text-sm text-gray-600" data-translate="Lanparty.Admin.Description"></p>
        </div>
      </header>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/admin/lanparty/users" class="rounded-lg bg-white p-5 shadow hover:shadow-lg transition">
          <h2 class="text-lg font-bold text-gray-800" data-translate="Lanparty.Admin.Users"></h2>
          <p class="mt-2 text-sm text-gray-600" data-translate="Lanparty.Admin.UsersDescription"></p>
        </a>
        <a href="/admin/lanparty/prices" class="rounded-lg bg-white p-5 shadow hover:shadow-lg transition">
          <h2 class="text-lg font-bold text-gray-800" data-translate="Lanparty.Admin.Prices"></h2>
          <p class="mt-2 text-sm text-gray-600" data-translate="Lanparty.Admin.PricesDescription"></p>
        </a>
        <a href="/admin/lanparty/payments" class="rounded-lg bg-white p-5 shadow hover:shadow-lg transition">
          <h2 class="text-lg font-bold text-gray-800" data-translate="Lanparty.Admin.Payments"></h2>
          <p class="mt-2 text-sm text-gray-600" data-translate="Lanparty.Admin.PaymentsDescription"></p>
        </a>
      </div>
    </main>
    <script src="<%= domain %>/appjs/permission.js?<%= curentUnixTime %>" defer></script>
    <script src="<%= domain %>/appjs/translate.js?<%= curentUnixTime %>"></script>
  </body>
</html>
