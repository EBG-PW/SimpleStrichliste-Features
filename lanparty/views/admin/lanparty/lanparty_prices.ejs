<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-translate="Lanparty.Prices.Title"></title>
    <%- html_content.manifest %>
    <script>
      const lang = <%- JSON.stringify(language) %>;
      const features = <%- JSON.stringify(features) %>;
    </script>
    <script src="<%= domain %>/libjs/i18next.js?<%= curentUnixTime %>"></script>
    <script src="<%= domain %>/libjs/tailwind.js?<%= curentUnixTime %>"></script>
  </head>
  <body class="bg-gray-100 font-sans">
    <%- html_content.navbar %>
    <main class="container mx-auto p-4 md:p-6">
      <header class="mb-6 flex items-center gap-4">
        <a href="/admin/lanparty" class="text-gray-500 hover:text-gray-800" aria-label="Go back">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800" data-translate="Lanparty.Prices.Title"></h1>
      </header>
      <section class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-lg bg-white p-5 shadow">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-gray-800" data-translate="Lanparty.Prices.FixKostenProTag"></h2>
            <button type="button" data-add-section="FixKostenProTag" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700" data-translate="Lanparty.Prices.Add"></button>
          </div>
          <div id="FixKostenProTag" class="space-y-3"></div>
        </div>
        <div class="rounded-lg bg-white p-5 shadow">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-gray-800" data-translate="Lanparty.Prices.PauschalkostenProTag"></h2>
            <button type="button" data-add-section="PauschalkostenProTag" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700" data-translate="Lanparty.Prices.Add"></button>
          </div>
          <div id="PauschalkostenProTag" class="space-y-3"></div>
        </div>
      </section>
      <div class="mt-6 flex justify-end">
        <button id="save-prices" type="button" class="rounded-md bg-green-600 px-5 py-3 font-semibold text-white hover:bg-green-700" data-translate="Lanparty.Prices.Save"></button>
      </div>
      <div id="message-box-container" class="fixed bottom-5 right-5 z-50 w-full max-w-xs">
        <div id="message-box" class="hidden mt-4 rounded-lg p-4 shadow-lg"></div>
      </div>
    </main>
    <script src="<%= domain %>/appjs/permission.js?<%= curentUnixTime %>" defer></script>
    <script src="<%= domain %>/appjs/translate.js?<%= curentUnixTime %>"></script>
    <script>
      const sections = ["FixKostenProTag", "PauschalkostenProTag"];
      const escapeHtml = (value) => String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");

      function addRow(section, item = {}) {
        const row = document.createElement("div");
        row.className = "grid grid-cols-[minmax(0,1fr)_8rem_2.5rem] gap-2";
        row.innerHTML = `
          <input type="text" data-field="name" value="${escapeHtml(item.name || "")}" class="min-w-0 rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="${escapeHtml(t("Lanparty.Prices.Name"))}" />
          <input type="number" data-field="amount" value="${escapeHtml(item.amount ?? 0)}" step="0.01" min="0" class="rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="${escapeHtml(t("Lanparty.Prices.Amount"))}" />
          <button type="button" class="rounded-md border border-red-200 text-red-700 hover:bg-red-50" aria-label="Remove">&times;</button>`;
        row.querySelector("button").addEventListener("click", () => row.remove());
        document.getElementById(section).appendChild(row);
      }

      function collectSection(section) {
        return [...document.getElementById(section).children].map((row) => ({
          name: row.querySelector('[data-field="name"]').value.trim(),
          amount: Number(row.querySelector('[data-field="amount"]').value || 0),
        })).filter((item) => item.name);
      }

      async function loadPrices() {
        const response = await apiFetch("/api/v1/lanparty/prices");
        const prices = await response.json();
        sections.forEach((section) => {
          document.getElementById(section).innerHTML = "";
          (prices[section] || []).forEach((item) => addRow(section, item));
          if (!prices[section]?.length) addRow(section);
        });
      }

      async function savePrices() {
        const button = document.getElementById("save-prices");
        button.disabled = true;
        try {
          const response = await apiFetch("/api/v1/lanparty/prices", {
            method: "PUT",
            body: JSON.stringify({
              FixKostenProTag: collectSection("FixKostenProTag"),
              PauschalkostenProTag: collectSection("PauschalkostenProTag"),
            }),
          });
          if (!response.ok) throw new Error("save failed");
          showMessage(t("Lanparty.Prices.Saved"));
          await loadPrices();
        } catch (error) {
          showMessage(t("Lanparty.Prices.Error"), "error");
        } finally {
          button.disabled = false;
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("[data-add-section]").forEach((button) => {
          button.addEventListener("click", () => addRow(button.dataset.addSection));
        });
        document.getElementById("save-prices").addEventListener("click", savePrices);
        loadPrices().catch(() => showMessage(t("Lanparty.Prices.Error"), "error"));
      });
    </script>
  </body>
</html>
