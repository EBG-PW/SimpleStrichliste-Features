<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-translate="Lanparty.Users.Title"></title>
    <%- html_content.manifest %>
    <script>
      const lang = <%- JSON.stringify(language) %>;
      const features = <%- JSON.stringify(features) %>;
    </script>
    <script src="<%= domain %>/libjs/i18next.js?<%= curentUnixTime %>"></script>
    <script src="<%= domain %>/libjs/tailwind.js?<%= curentUnixTime %>"></script>
  </head>
  <body class="bg-gray-100 font-sans">
    <%- html_content.navbar %>
    <main class="container mx-auto p-4 md:p-6">
      <header class="mb-6 flex items-center gap-4">
        <a href="/admin/lanparty" class="text-gray-500 hover:text-gray-800" aria-label="Go back">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800" data-translate="Lanparty.Users.Title"></h1>
      </header>
      <div class="overflow-x-auto rounded-lg bg-white shadow">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-900 text-left text-xs uppercase tracking-wide text-gray-200" id="lan-users-head"></thead>
          <tbody class="divide-y divide-gray-100" id="lan-users-body"></tbody>
        </table>
      </div>
    </main>
    <script src="<%= domain %>/appjs/permission.js?<%= curentUnixTime %>" defer></script>
    <script src="<%= domain %>/appjs/translate.js?<%= curentUnixTime %>"></script>
    <script>
      const formatMoney = (value) => `${Number(value || 0).toFixed(2)} EUR`;
      const escapeHtml = (value) => String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
      document.addEventListener("DOMContentLoaded", async () => {
        const response = await apiFetch("/api/v1/lanparty/users");
        const data = await response.json();
        const fields = data.fields || [];
        const head = document.getElementById("lan-users-head");
        head.innerHTML = `<tr>
          <th class="px-3 py-2">${t("Lanparty.Users.Name")}</th>
          <th class="px-3 py-2">${t("Lanparty.Users.Arrival")}</th>
          <th class="px-3 py-2">${t("Lanparty.Users.Departure")}</th>
          ${fields.map((field) => `<th class="px-3 py-2">${escapeHtml(field.label || field.key)}</th>`).join("")}
          <th class="px-3 py-2">${t("Lanparty.Users.Amount")}</th>
        </tr>`;
        const body = document.getElementById("lan-users-body");
        if (!data.users?.length) {
          body.innerHTML = `<tr><td colspan="${4 + fields.length}" class="px-3 py-4 text-gray-500">${t("Lanparty.Users.Empty")}</td></tr>`;
          return;
        }
        body.innerHTML = data.users.map((user) => `<tr>
          <td class="px-3 py-2 font-semibold">${escapeHtml(user.name)}</td>
          <td class="px-3 py-2">${escapeHtml(user.arrival_date)}</td>
          <td class="px-3 py-2">${escapeHtml(user.departure_date)}</td>
          ${fields.map((field) => `<td class="px-3 py-2">${escapeHtml(user.extra_data?.[field.key])}</td>`).join("")}
          <td class="px-3 py-2">${formatMoney(user.amount)}</td>
        </tr>`).join("");
      });
    </script>
  </body>
</html>
